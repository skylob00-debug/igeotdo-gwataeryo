# 이 파일을 .env 로 복사해 값을 채운다. .env 는 gitignore 된다.

# 법제처 국가법령정보 OPEN API
#   https://open.law.go.kr 에서 신청. OC 는 신청 이메일 ID 앞부분.
#   비워 두면 'test'(법제처 테스트용)로 동작한다. 운영에 쓰면 안 된다.
LAW_API_OC=

# Supabase
#   프로젝트 설정 > API 에서 확인.
#   SERVICE_KEY 는 RLS 를 우회하므로 절대 앱에 넣지 말 것. 적재 스크립트 전용이다.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Supabase publishable 키 (공개 키. 앱에 들어간다)
#   RLS 검증(check_rls.py)과 Flutter 앱이 쓴다.
SUPABASE_ANON_KEY=

# law-watch / push-notify Edge Function 호출용 임의 문자열
#   Supabase Edge Function Secrets 에 같은 값을 등록한다.
CRON_SECRET=

# Firebase (FCM 푸시)
#   콘솔 > 프로젝트 설정 > 일반 > 내 앱(Android) 에서 가져온다.
#   앱에 그대로 들어가는 공개 값이다. 비밀이 아니다.
#   export_seed.py 가 app/env.json 으로 옮겨 준다. 비워 두면 푸시만 꺼진다.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_SENDER_ID=
FIREBASE_PROJECT_ID=

# 발송용 서비스 계정 (보내는 쪽에서만 쓴다. 절대 앱에 넣지 말 것)
#   콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 -> JSON 파일
#   로컬에서는 파일 경로를, Edge Function Secrets 에는 JSON 내용 전체를
#   FIREBASE_SERVICE_ACCOUNT 이름으로 넣는다.
FIREBASE_SERVICE_ACCOUNT_FILE=
